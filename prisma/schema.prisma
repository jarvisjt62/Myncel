  color          String? // UI badge hex color, e.g. "#635bff"
  icon           String? // emoji or icon identifier
  isSystem       Boolean              @default(false) // built-in roles (OWNER/ADMIN/etc) cannot be deleted
  isGlobal       Boolean              @default(false) // created by platform admin, visible to all orgs
  isDisabled     Boolean              @default(false) // platform-admin override to disable without deleting
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?                @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
