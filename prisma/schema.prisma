// =================================================================
// SSO / SCIM  (per-tenant identity-provider configuration)
// =================================================================
//
// Myncel speaks SAML 2.0 (browser-redirect, signed AuthnRequest, signed
// SAMLResponse) for sign-in and SCIM 2.0 (bearer-token REST) for user
// auto-provisioning. Both are optional and configured per-organization
// — different tenants can plug into Okta, Azure AD, Google Workspace,
// OneLogin, JumpCloud, or any other SAML IdP independently.
//
// SsoConfig holds the IdP metadata and the SP-side certificate used to
// sign AuthnRequests. ScimToken holds the bearer secrets the IdP sends
// when provisioning users; we store only a SHA-256 hash so the secret
// itself is non-recoverable from the database.

model SsoConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Whether SSO is currently active for this org. When false the
  // /api/auth/saml/* endpoints return 404 even if the row exists.
  enabled Boolean @default(false)

  // When true, ALL non-OWNER users in this org MUST sign in via SAML.
  // Password and Google logins are blocked. Owners can still password-
  // sign-in as a break-glass mechanism.
  enforced Boolean @default(false)

  // IdP metadata (provided by the customer's IdP admin).
  idpEntityId    String  @db.Text // e.g. "https://sts.windows.net/<tenant>/"
  idpSsoUrl      String  @db.Text // SAML 2.0 SSO POST endpoint
  idpCertificate String  @db.Text // X.509 PEM, used to verify SAMLResponse signatures
  // Optional: overrides the default email NameID format (most IdPs
  // ship "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress").
  nameIdFormat   String?

  // Attribute mappings (defaults match Microsoft / Okta out-of-the-box).
  emailAttribute     String? // default: email or http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
  firstNameAttribute String?
  lastNameAttribute  String?
  groupsAttribute    String? // default: "groups" — mapped to Myncel role

  // Default role assigned on first JIT provisioning if no group claim
  // matches. Owners can lock this to MEMBER for safety.
  defaultRole UserRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sso_configs")
}

model ScimToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // First 8 chars of the token, shown in the UI so admins can identify
  // which token is which without revealing the full secret.
  prefix String

  // SHA-256 hex of the full bearer token. The plaintext is shown ONCE
  // at creation time and never persisted.
  tokenHash String @unique

  // Human-readable label, e.g. "Okta production" or "Azure AD".
  label String

  // Audit fields.
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String? // userId of the admin who minted the token
  revokedAt  DateTime?

  @@index([organizationId])
  @@map("scim_tokens")
}

model Webhook {
  id              String    @id @default(cuid())
  name            String
  url             String
  secret          String? // For signature verification
  events          Json // Array of event types to trigger on
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  failureCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationId  String?
  integration    Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

