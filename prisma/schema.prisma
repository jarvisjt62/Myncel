// Myncel — Full Production Schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hashed with bcrypt
  image         String?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Two-Factor Authentication
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String? // TOTP secret (encrypted)
  twoFactorBackupCodes String? // JSON array of hashed backup codes

  // Account Security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // Account lockout timestamp
  lastLoginAt         DateTime?
  lastLoginIp         String?

  // Account Deletion (Apple App Review Guideline 5.1.1(v))
  // When a user initiates deletion, deletionRequestedAt is set to now()
  // and the user is signed out. They are blocked from signing in while
  // this is set. After GRACE_PERIOD_DAYS (14) the cron job in
  // /api/cron/purge-deleted-accounts hard-deletes the row. The user
  // can sign back in within the grace period to clear the field and
  // recover their account.
  deletionRequestedAt DateTime?

  // SSO (SAML 2.0)
  // When the user signs in via SAML, we record the IdP-asserted NameID
  // here so subsequent SSO sign-ins can match the same human even if
  // their email changes upstream.
  samlNameId String?

  // SCIM
  // When this user was provisioned by an IdP via SCIM 2.0, we keep the
  // external IdP identifier so PATCH/DELETE from the IdP can match the
  // row reliably (regardless of how the IdP cycles emails).
  scimExternalId String?
  // True when this user is owned by SCIM provisioning. Local UI hides
  // delete and role-edit affordances on SCIM-managed rows so the IdP
  // remains the source of truth.
  scimManaged Boolean @default(false)

  // Relations
  organizationId              String?
  organization                Organization?              @relation(fields: [organizationId], references: [id])
  accounts                    Account[]
  sessions                    Session[]
  workOrders                  WorkOrder[]                @relation("AssignedTo")
  createdWorkOrders           WorkOrder[]                @relation("CreatedBy")
  createdWorkOrderTemplates   WorkOrderTemplate[]        @relation("TemplateCreatedBy")
  passwordResets              PasswordReset[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  sentInvites                 InviteToken[]              @relation("InvitedBy")
  remoteSupportCreated        RemoteSupportSession[]     @relation("RemoteSupportCreatedBy")
  remoteSupportParticipations RemoteSupportParticipant[] @relation("RemoteSupportParticipants")

  // Custom roles system (many-to-many)
  roleAssignments UserRoleAssignment[]
  createdRoles    Role[]               @relation("RoleCreatedBy")

  // Mobile app
  mobilePushTokens MobilePushToken[]

  // Saved & scheduled reports
  savedReports SavedReport[] @relation("SavedReportOwner")

  // Multi-step approvals
  approvalRequests  ApprovalRequest[]  @relation("ApprovalRequester")
  approvalDecisions ApprovalDecision[] @relation("ApprovalDecider")

  // Equipment documents this user uploaded
  uploadedMachineDocuments MachineDocument[]

  @@map("users")
}

model MobilePushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique // Expo push token (ExponentPushToken[...])
  platform   String // "ios" | "android"
  deviceName String?
  appVersion String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@map("mobile_push_tokens")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Enhanced Session Tracking
  ipAddress    String?
  userAgent    String?
  deviceName   String? // e.g., "Chrome on Windows"
  lastActivity DateTime @default(now())
  isActive     Boolean  @default(true)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ===== TEAM INVITE TOKENS =====

model InviteToken {
  id             String       @id @default(cuid())
  token          String       @unique @default(cuid())
  email          String
  role           UserRole     @default(TECHNICIAN)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  expires        DateTime
  used           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("invite_tokens")
}

// ===== ORGANIZATION =====

model Organization {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  industry    Industry  @default(OTHER)
  size        OrgSize   @default(SMALL)
  plan        Plan      @default(TRIAL)
  trialEndsAt DateTime?

  // Stripe billing
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  subscriptionStatus   String?   @default("trialing")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // ACH bank account
  achBankAccount       String?
  paypalSubscriptionId String?

  // Localization
  currency    String    @default("USD") // ISO 4217 currency code (e.g. USD, EUR, GBP, NGN)
  // Floor plan (HMI)
  floorPlanImageUrl  String? @db.Text // base64 data URL of floor plan image
  floorPlanPositions String? @db.Text // JSON string of machine positions

  // Admin control
  isActive        Boolean   @default(true)
  isSuspended     Boolean   @default(false)
  adminNotes      String?   @db.Text
  suspendedAt     DateTime?
  suspendedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                 User[]
  machines              Machine[]
  workOrders            WorkOrder[]
  workOrderTemplates    WorkOrderTemplate[]
  maintenanceTasks      MaintenanceTask[]
  alerts                Alert[]
  parts                 Part[]
  auditLogs             AuditLog[]
  integrations          Integration[]
  webhooks              Webhook[]
  notificationSettings  NotificationSetting?
  inviteTokens          InviteToken[]
  remoteSupportSessions RemoteSupportSession[]
  machineDeviceTokens   MachineDeviceToken[]
  savedReports          SavedReport[]
  approvalPolicies      ApprovalPolicy[]
  approvalRequests      ApprovalRequest[]
  machineDocuments      MachineDocument[]

  // Location hierarchy (Site → Building → Floor → Room)
  sites     Site[]
  buildings Building[]
  floors    Floor[]
  rooms     Room[]

  // Custom roles per org
  customRoles Role[]

  // SSO / SCIM (per-tenant identity-provider config)
  ssoConfig   SsoConfig?
  scimTokens  ScimToken[]

  @@map("organizations")
}

// ===== MACHINES =====

model Machine {
  id            String          @id @default(cuid())
  name          String
  model         String?
  manufacturer  String?
  serialNumber  String?
  yearInstalled Int?
  location      String? // legacy free-text fallback (still displayed when hierarchy fields are empty)

  // Structured location hierarchy (all optional — set as much or as little as you want)
  siteId     String?
  buildingId String?
  floorId    String?
  roomId     String?
  site       Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor      Floor?    @relation(fields: [floorId], references: [id], onDelete: SetNull)
  room       Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  category      MachineCategory @default(OTHER)
  status        MachineStatus   @default(OPERATIONAL)
  criticality   Criticality     @default(MEDIUM)
  notes         String?         @db.Text
  imageUrl      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Runtime tracking
  totalHours    Float     @default(0)
  lastServiceAt DateTime?

  // Relations
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maintenanceTasks      MaintenanceTask[]
  workOrders            WorkOrder[]
  alerts                Alert[]
  sensorReadings        SensorReading[]
  machineDeviceTokens   MachineDeviceToken[]
  remoteSupportSessions RemoteSupportSession[]
  documents             MachineDocument[]

  @@index([organizationId, siteId])
  @@index([organizationId, buildingId])
  @@index([organizationId, floorId])
  @@index([organizationId, roomId])
  @@map("machines")
}

// ===== LOCATION HIERARCHY (Site → Building → Floor → Room) =====
//
// All four levels are optional on Machine; you can set any prefix you like
// (e.g. just Site, or Site + Building) and the rest of the chain stays null.
// Deletes cascade DOWN (delete a Site → all its Buildings/Floors/Rooms go).
// Machines whose linked level is deleted get SetNull so the row survives.

model Site {
  id        String   @id @default(cuid())
  name      String
  code      String? // optional short code (e.g. "PLT-1")
  address   String?
  timezone  String? // e.g. "America/Chicago" — optional, falls back to org tz
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  buildings Building[]
  floors    Floor[]
  rooms     Room[]
  machines  Machine[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("sites")
}

model Building {
  id        String   @id @default(cuid())
  name      String
  code      String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  floors   Floor[]
  rooms    Room[]
  machines Machine[]

  @@unique([siteId, name])
  @@index([organizationId])
  @@index([siteId])
  @@map("buildings")
}

model Floor {
  id        String   @id @default(cuid())
  name      String // e.g. "Ground", "Floor 2", "Mezzanine"
  level     Int? // numeric floor level if applicable (0 = ground, -1 = basement)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  rooms    Room[]
  machines Machine[]

  @@unique([buildingId, name])
  @@index([organizationId])
  @@index([buildingId])
  @@index([siteId])
  @@map("floors")
}

model Room {
  id        String   @id @default(cuid())
  name      String // e.g. "Bay A", "Line 3", "Mech Room"
  code      String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  floorId    String
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  machines Machine[]

  @@unique([floorId, name])
  @@index([organizationId])
  @@index([floorId])
  @@index([buildingId])
  @@index([siteId])
  @@map("rooms")
}

// ===== MAINTENANCE TASKS (PM Schedules) =====

model MaintenanceTask {
  id               String    @id @default(cuid())
  title            String
  description      String?   @db.Text
  taskType         TaskType  @default(PREVENTIVE)
  frequency        Frequency @default(MONTHLY)
  intervalDays     Int? // for custom intervals
  intervalHours    Float? // for hour-based intervals
  estimatedMinutes Int?
  estimatedCost    Float?
  currency         String?   @default("USD") // ISO 4217 — the currency this estimatedCost is denominated in
  priority         Priority  @default(MEDIUM)
  isActive         Boolean   @default(true)
  nextDueAt        DateTime?
  lastCompletedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  machineId      String
  machine        Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrders     WorkOrder[]

  @@map("maintenance_tasks")
}

// ===== WORK ORDERS =====

model WorkOrder {
  id               String          @id @default(cuid())
  woNumber         String          @unique // e.g. WO-2026-0042
  title            String
  description      String?         @db.Text
  type             WorkOrderType   @default(PREVENTIVE)
  status           WorkOrderStatus @default(OPEN)
  priority         Priority        @default(MEDIUM)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  dueAt            DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  laborCost        Float?
  partsCost        Float?
  totalCost        Float?
  currency         String?         @default("USD") // ISO 4217 — the currency these costs are denominated in
  notes            String?         @db.Text
  completionNotes  String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  machineId             String
  machine               Machine                @relation(fields: [machineId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToId          String?
  assignedTo            User?                  @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById           String?
  createdBy             User?                  @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  maintenanceTaskId     String?
  maintenanceTask       MaintenanceTask?       @relation(fields: [maintenanceTaskId], references: [id])
  parts                 WorkOrderPart[]
  remoteSupportSessions RemoteSupportSession[]
  approvalRequests      ApprovalRequest[]

  @@map("work_orders")
}

// ===== WORK ORDER TEMPLATES =====
//
// Reusable templates that pre-fill the "Create Work Order" form. Org-
// scoped; do NOT belong to a specific machine. When a user spawns a
// WO from a template they pick the machine + due date at spawn time
// and the rest of the fields autofill.
//
// Roadmap chapter "Work orders" → Reusable Work Order templates.

model WorkOrderTemplate {
  id               String        @id @default(cuid())
  name             String        // Human-readable e.g. "30-day Haas VF-2 PM"
  title            String        // Template's default WO title (can include {machine} placeholder later)
  description      String?       @db.Text
  type             WorkOrderType @default(PREVENTIVE)
  priority         Priority      @default(MEDIUM)
  estimatedMinutes Int?
  laborCost        Float?
  partsCost        Float?
  currency         String?       @default("USD")
  notes            String?       @db.Text
  // Soft-archive flag — keeps history but hides from selectors.
  isArchived       Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, isArchived])
  @@map("work_order_templates")
}

// ===== PARTS INVENTORY =====

model Part {
  id          String   @id @default(cuid())
  name        String
  partNumber  String?
  description String?
  quantity    Int      @default(0)
  minQuantity Int      @default(1) // reorder point
  unitCost    Float?
  currency    String?  @default("USD") // ISO 4217 — the currency unitCost is denominated in
  supplier    String?
  location    String? // shelf/bin location
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  imageUrl String? // uploaded photo of the part

  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrders     WorkOrderPart[]

  @@map("parts")
}

model WorkOrderPart {
  id       String @id @default(cuid())
  quantity Int    @default(1)
  unitCost Float?

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id])

  @@map("work_order_parts")
}

// ===== ALERTS =====

model Alert {
  id         String    @id @default(cuid())
  type       AlertType
  title      String
  message    String    @db.Text
  severity   Severity  @default(MEDIUM)
  isRead     Boolean   @default(false)
  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  machineId      String?
  machine        Machine?     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

// ===== SENSOR READINGS =====

model SensorReading {
  id         String   @id @default(cuid())
  type       String // temperature, vibration, pressure, etc.
  value      Float
  unit       String // °C, mm/s, PSI, etc.
  recordedAt DateTime @default(now())

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId, type, recordedAt])
  @@map("sensor_readings")
}

// ===== MACHINE DEVICE TOKENS =====

model MachineDeviceToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  isActive    Boolean   @default(true)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  machineId      String
  machine        Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([organizationId])
  @@map("machine_device_tokens")
}

// ===== MACHINE DOCUMENTS =====
//
// Drawings, P&IDs, manuals, datasheets, certifications, photos — anything
// you'd attach to a piece of equipment. The `kind` field drives icon
// selection and inline-preview behaviour (PDF embedded, images inline,
// DXF/DWG offered as download with an open-in-CAD link).

model MachineDocument {
  id          String              @id @default(cuid())
  name        String
  description String?             @db.Text
  kind        MachineDocumentKind @default(OTHER)
  /// Public URL or data URL. Today we accept either a hosted URL (S3/R2)
  /// or a base64 data URL pasted directly. Server enforces a soft cap.
  url         String              @db.Text
  /// Original filename (preserved for download).
  filename    String?
  /// MIME type, used to choose inline preview vs. download.
  mimeType    String?
  /// Bytes — display only.
  sizeBytes   Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  machineId      String
  machine        Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([machineId])
  @@index([organizationId])
  @@map("machine_documents")
}

enum MachineDocumentKind {
  MANUAL // OEM operating manual / service manual / parts catalog
  DRAWING // Mechanical / electrical CAD drawing (DXF, DWG, PDF)
  PNID // Process & instrumentation diagram
  DATASHEET // Spec sheet / cut sheet
  CERTIFICATE // Safety certs, calibration certs, inspection reports
  PHOTO // Reference photos
  OTHER
}

// ===== NOTIFICATIONS =====

model Notification {
  id        String               @id @default(cuid())
  type      NotificationType
  title     String
  message   String               @db.Text
  priority  NotificationPriority @default(NORMAL)
  isRead    Boolean              @default(false)
  link      String? // URL to related resource
  createdAt DateTime             @default(now())
  readAt    DateTime?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Polymorphic relation data
  relatedType String? // 'work_order', 'machine', 'alert', etc.
  relatedId   String? // ID of the related entity

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ===== AUDIT LOGS =====

model AuditLog {
  id        String   @id @default(cuid())
  action    String // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String // Model name (User, Machine, WorkOrder, etc.)
  entityId  String? // ID of the affected entity
  changes   Json? // Before/after values for updates
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ===== ADMIN SETTINGS =====

model AdminSetting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "payment.stripe.enabled", "feature.iot.enabled"
  value     String   @db.Text // JSON-encoded value
  group     String   @default("general") // payment, feature, platform, security
  label     String? // Human-readable label
  updatedAt DateTime @updatedAt
  updatedBy String? // admin user id

  @@map("admin_settings")
}

// ===== ENUMS =====

enum UserRole {
  OWNER
  ADMIN
  TECHNICIAN
  OPERATOR
  EMPLOYEE
  MEMBER
}

enum Plan {
  TRIAL
  TRIAL_RESTRICTED
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

enum Industry {
  METAL_FABRICATION
  PLASTICS
  FOOD_BEVERAGE
  AUTO_PARTS
  ELECTRONICS
  WOODWORKING
  OTHER
}

enum OrgSize {
  SMALL
  GROWING
  MIDSIZE
  LARGE
}

enum MachineCategory {
  CNC_MILL
  CNC_LATHE
  PRESS
  HYDRAULIC
  COMPRESSOR
  CONVEYOR
  WELDER
  INJECTION_MOLD
  ASSEMBLY
  LASER_CUTTER
  PLASMA_CUTTER
  GRINDER
  DRILL_PRESS
  PUNCH_PRESS
  PUMP
  BOILER
  GENERATOR
  CRANE
  ROBOT
  HEAT_TREATMENT
  MEASURING
  PACKAGING
  FORKLIFT
  VEHICLE_LIGHT
  VEHICLE_HEAVY
  VESSEL
  DRONE_UAV
  OTHER
}

enum MachineStatus {
  OPERATIONAL
  MAINTENANCE
  BREAKDOWN
  RETIRED
}

enum Criticality {
  HIGH
  MEDIUM
  LOW
}

enum TaskType {
  PREVENTIVE
  PREDICTIVE
  CORRECTIVE
  INSPECTION
}

enum Frequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
  CUSTOM
  BY_HOURS
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  INSPECTION
  PROJECT
}

enum WorkOrderStatus {
  OPEN
  PENDING_APPROVAL
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AlertType {
  MAINTENANCE_DUE
  MAINTENANCE_OVERDUE
